<%# Used for /archives/ and, by fallback, tag and category pages %>
<% let year = null; %>
<% page.posts.each(function (post) { %>
    <% const y = date(post.date, 'YYYY'); %>
    <% if (y !== year) { %>
        <% if (year !== null) { %></ul></section><% } %>
        <% year = y; %>
        <section class="year">
            <h2><%= y %></h2>
            <ul class="archive-list">
    <% } %>
                <li>
                    <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'D MMM') %></time>
                    <a href="<%- url_for(post.path) %>"><%= post.title %></a>
                </li>
<% }) %>
<% if (year !== null) { %></ul></section><% } else { %><p class="empty">No posts yet.</p><% } %>
<%- partial('partial/pagination') %>
